@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    string? dashboardUrl = null;
    if (User.IsInRole(nameof(UserRole.SuperAdmin))) { dashboardUrl = "/SuperAdmin"; }
    else if (User.IsInRole(nameof(UserRole.UniversityAdmin))) { dashboardUrl = "/Admin"; }
    else if (User.IsInRole(nameof(UserRole.Student))) { dashboardUrl = "/Student/MyCertificates"; }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>QR Certificate System - Digital Certificate Platform</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand-1: #667eea;
            --brand-2: #764ba2;
            --brand-gradient: linear-gradient(135deg, var(--brand-1) 0%, var(--brand-2) 100%);
            --text-dark: #2d3748;
            --text-muted: #718096;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #fff;
            color: var(--text-dark);
        }

        /* ---------- Navbar ---------- */
        .navbar {
            background: rgba(255, 255, 255, 0.97) !important;
            backdrop-filter: blur(20px);
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
            padding: 0.9rem 0;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.4rem;
            background: var(--brand-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Both navbar buttons share one size so they line up. */
        .btn-nav {
            min-width: 120px;
            height: 40px;
            padding: 0 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.95rem;
            white-space: nowrap;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-nav-primary {
            background: var(--brand-gradient);
            color: #fff;
            border: none;
        }

        .btn-nav-primary:hover {
            color: #fff;
            box-shadow: 0 6px 18px rgba(102, 126, 234, 0.35);
        }

        .btn-nav-outline {
            background: #fff;
            color: var(--brand-1);
            border: 2px solid var(--brand-1);
        }

        .btn-nav-outline:hover {
            background: var(--brand-1);
            color: #fff;
        }

        .btn-nav-danger {
            background: #fff;
            color: #dc3545;
            border: 2px solid #dc3545;
        }

        .btn-nav-danger:hover {
            background: #dc3545;
            color: #fff;
        }

        /* ---------- Hero ---------- */
        .hero-section {
            background: var(--brand-gradient);
            padding: 130px 0 90px;
            color: #fff;
            text-align: center;
        }

        .hero-title {
            font-size: clamp(2.2rem, 5vw, 3.4rem);
            font-weight: 700;
            margin-bottom: 1rem;
            text-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .hero-subtitle {
            font-size: 1.2rem;
            opacity: 0.92;
            margin-bottom: 3.5rem;
        }

        /* Cards are flex columns: the description grows, the button sticks to the bottom. */
        .feature-card {
            background: rgba(255, 255, 255, 0.97);
            border-radius: 22px;
            padding: 2.5rem 1.75rem 2rem;
            text-align: center;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.1);
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.15);
        }

        .feature-icon {
            width: 76px;
            height: 76px;
            border-radius: 20px;
            background: var(--brand-gradient);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.35);
        }

        .feature-title {
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
            color: var(--text-dark);
        }

        .feature-desc {
            color: var(--text-muted);
            line-height: 1.6;
            font-size: 0.95rem;
            margin-bottom: 1.75rem;
            flex-grow: 1;
        }

        .btn-feature {
            width: 100%;
            height: 50px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            white-space: nowrap;
            background: var(--brand-gradient);
            border: none;
            border-radius: 14px;
            color: #fff;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 8px 22px rgba(102, 126, 234, 0.3);
            transition: all 0.2s ease;
        }

        .btn-feature:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(102, 126, 234, 0.4);
        }

        /* ---------- Quick verification ---------- */
        .verify-section {
            padding: 5rem 0 4rem;
        }

        .section-title {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .section-subtitle {
            color: var(--text-muted);
            margin-bottom: 2rem;
        }

        .verify-form .form-control {
            height: 56px;
            border-radius: 14px 0 0 14px;
            border: 2px solid #e2e8f0;
            font-size: 1.05rem;
        }

        .verify-form .form-control:focus {
            border-color: var(--brand-1);
            box-shadow: none;
        }

        .verify-form .btn {
            height: 56px;
            min-width: 140px;
            border-radius: 0 14px 14px 0;
            background: var(--brand-gradient);
            border: none;
            color: #fff;
            font-weight: 600;
            white-space: nowrap;
        }

        .steps {
            margin-top: 3.5rem;
        }

        .step {
            background: #f8f9fc;
            border-radius: 18px;
            padding: 1.75rem 1.5rem;
            height: 100%;
            text-align: center;
        }

        .step-icon {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: #fff;
            color: var(--brand-1);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            box-shadow: 0 6px 18px rgba(102, 126, 234, 0.2);
            margin-bottom: 1rem;
        }

        .step-number {
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            color: var(--brand-1);
            text-transform: uppercase;
        }

        .step h5 {
            font-weight: 700;
            margin: 0.35rem 0 0.5rem;
        }

        .step p {
            color: var(--text-muted);
            font-size: 0.92rem;
            margin: 0;
        }

        /* ---------- Stats ---------- */
        .stats-section {
            padding: 3.5rem 0;
            background: #f8f9fc;
        }

        .stat-number {
            font-size: 2.6rem;
            font-weight: 700;
            color: var(--brand-1);
        }

        .stat-label {
            color: var(--text-muted);
            font-weight: 500;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-certificate"></i>
                QR Certificate System
            </a>

            <div class="d-flex align-items-center gap-2">
                @if (isSignedIn)
                {
                    <a href="/Account/Profile" class="btn-nav btn-nav-outline">
                        <i class="fas fa-user"></i> @User.Identity!.Name
                    </a>
                    <a href="@dashboardUrl" class="btn-nav btn-nav-primary">
                        <i class="fas fa-gauge"></i> Dashboard
                    </a>
                    <partial name="_LogoutButton" model="@("btn-nav btn-nav-danger")" />
                }
                else
                {
                    <a href="/Account/Login" class="btn-nav btn-nav-outline">
                        <i class="fas fa-right-to-bracket"></i> Sign In
                    </a>
                    <a href="/Account/Register" class="btn-nav btn-nav-primary">
                        <i class="fas fa-user-plus"></i> Register
                    </a>
                }
            </div>
        </div>
    </nav>

    <section class="hero-section">
        <div class="container">
            <h1 class="hero-title">Digital Certificate Platform</h1>
            <p class="hero-subtitle">
                Universities issue tamper-proof certificates, students keep them, anyone verifies them with a QR code.
            </p>

            <div class="row g-4 justify-content-center">
                <div class="col-xl-3 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-magnifying-glass"></i></div>
                        <h3 class="feature-title">Verify Certificate</h3>
                        <p class="feature-desc">Scan the QR code or enter the certificate ID to check if it is genuine.</p>
                        <a href="/verify" class="btn-feature"><i class="fas fa-search"></i> Verify</a>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-user-graduate"></i></div>
                        <h3 class="feature-title">Students</h3>
                        <p class="feature-desc">View your certificates and download them as PDF.</p>
                        @if (User.IsInRole(nameof(UserRole.Student)))
                        {
                            <a href="/Student/MyCertificates" class="btn-feature"><i class="fas fa-eye"></i> My Certificates</a>
                        }
                        else if (isSignedIn)
                        {
                            <a href="@dashboardUrl" class="btn-feature"><i class="fas fa-gauge"></i> Dashboard</a>
                        }
                        else
                        {
                            <a href="/Account/Register" class="btn-feature"><i class="fas fa-user-plus"></i> Register</a>
                        }
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-building-columns"></i></div>
                        <h3 class="feature-title">Universities</h3>
                        <p class="feature-desc">Issue, edit and revoke digitally signed certificates.</p>
                        @if (User.IsInRole(nameof(UserRole.UniversityAdmin)))
                        {
                            <a href="/Admin" class="btn-feature"><i class="fas fa-gauge"></i> Admin Panel</a>
                        }
                        else if (isSignedIn)
                        {
                            <a href="@dashboardUrl" class="btn-feature"><i class="fas fa-gauge"></i> Dashboard</a>
                        }
                        else
                        {
                            <a href="/Account/RegisterUniversity" class="btn-feature"><i class="fas fa-building"></i> Apply</a>
                        }
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="feature-card">
                        <div class="feature-icon"><i class="fas fa-user-circle"></i></div>
                        <h3 class="feature-title">My Profile</h3>
                        <p class="feature-desc">See your account and university information.</p>
                        @if (isSignedIn)
                        {
                            <a href="/Account/Profile" class="btn-feature"><i class="fas fa-user"></i> Profile</a>
                        }
                        else
                        {
                            <a href="/Account/Login" class="btn-feature"><i class="fas fa-right-to-bracket"></i> Sign In</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="verify-section">
        <div class="container">
            <div class="row justify-content-center text-center">
                <div class="col-lg-7">
                    <h2 class="section-title">Quick Verification</h2>
                    <p class="section-subtitle">
                        Enter the ID printed on the certificate. Scanning the QR code with a phone camera opens the same result directly.
                    </p>
                    <form action="/verify" method="get" class="verify-form">
                        <div class="input-group">
                            <input type="text" name="certificateId" class="form-control"
                                   placeholder="e.g. CERT-2026-1A2B3C4D5E6F" required>
                            <button type="submit" class="btn">
                                <i class="fas fa-search me-1"></i> Verify
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="row g-4 steps">
                <div class="col-md-4">
                    <div class="step">
                        <div class="step-icon"><i class="fas fa-signature"></i></div>
                        <div class="step-number">Step 1</div>
                        <h5>University issues</h5>
                        <p>Each certificate is signed with a secret key that only the server knows.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="step">
                        <div class="step-icon"><i class="fas fa-qrcode"></i></div>
                        <div class="step-number">Step 2</div>
                        <h5>QR on the diploma</h5>
                        <p>The printed diploma carries a QR code that links to its verification page.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="step">
                        <div class="step-icon"><i class="fas fa-circle-check"></i></div>
                        <div class="step-number">Step 3</div>
                        <h5>Anyone verifies</h5>
                        <p>The signature and status are checked: valid, revoked or tampered.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="stats-section">
        <div class="container">
            <div class="row text-center g-4">
                <div class="col-md-4">
                    <div class="stat-number">@ViewBag.ActiveCertificates</div>
                    <div class="stat-label">Active Certificates</div>
                </div>
                <div class="col-md-4">
                    <div class="stat-number">@ViewBag.Universities</div>
                    <div class="stat-label">Universities</div>
                </div>
                <div class="col-md-4">
                    <div class="stat-number">@ViewBag.Verifications</div>
                    <div class="stat-label">Verifications</div>
                </div>
            </div>
        </div>
    </section>

    <footer class="bg-dark text-white py-4">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <strong>QR Certificate System</strong>
                <span class="opacity-75 ms-2">Secure digital certificate management platform</span>
            </div>
            <a href="/verify" class="text-white-50 text-decoration-none"><i class="fas fa-search me-1"></i>Verify a certificate</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
