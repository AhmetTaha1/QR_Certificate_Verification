@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    string? dashboardUrl = null;
    if (User.IsInRole(nameof(UserRole.SuperAdmin))) { dashboardUrl = "/SuperAdmin"; }
    else if (User.IsInRole(nameof(UserRole.UniversityAdmin))) { dashboardUrl = "/Admin"; }
    else if (User.IsInRole(nameof(UserRole.Student))) { dashboardUrl = "/Student/MyCertificates"; }
}

<!DOCTYPE html>
<html>
<head>
    <title>QR Certificate System - Digital Certificate Platform</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }

        .navbar {
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(20px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            padding: 1rem 0;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-section {
            padding: 120px 0 80px;
            color: white;
            text-align: center;
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            text-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        }

        .hero-subtitle {
            font-size: 1.3rem;
            margin-bottom: 3rem;
            opacity: 0.9;
        }

        .feature-cards {
            margin-top: 4rem;
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-radius: 25px;
            padding: 3rem 2rem;
            text-align: center;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.3);
            transition: all 0.4s ease;
            height: 100%;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .feature-card:before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.05), transparent);
            transition: left 0.5s;
        }

        .feature-card:hover:before {
            left: 100%;
        }

        .feature-card:hover {
            transform: translateY(-15px) scale(1.02);
            box-shadow: 0 25px 70px rgba(102, 126, 234, 0.15);
        }

        .feature-icon {
            font-size: 3.5rem;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 2rem;
            position: relative;
            z-index: 2;
        }

        .feature-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: #2d3748;
            position: relative;
            z-index: 2;
        }

        .feature-desc {
            color: #718096;
            line-height: 1.6;
            margin-bottom: 2.5rem;
            font-size: 0.95rem;
            position: relative;
            z-index: 2;
        }

        .btn-feature {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 15px;
            padding: 15px 35px;
            color: white;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-block;
            font-size: 1rem;
            width: 80%;
            position: relative;
            z-index: 2;
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
        }

        .btn-feature:hover {
            transform: translateY(-3px);
            color: white;
            box-shadow: 0 12px 35px rgba(102, 126, 234, 0.4);
        }

        .btn-feature.disabled {
            background: linear-gradient(135deg, #dc3545, #c82333);
            cursor: pointer;
            box-shadow: 0 8px 25px rgba(220, 53, 69, 0.3);
        }

        .btn-feature.disabled:hover {
            background: linear-gradient(135deg, #c82333, #a71e2a);
            box-shadow: 0 12px 35px rgba(220, 53, 69, 0.4);
        }

        .main-content {
            background: white;
            border-radius: 40px 40px 0 0;
            padding: 5rem 0;
            margin-top: 6rem;
        }

        .btn-auth {
            background: linear-gradient(135deg, #28a745, #20c997);
            border: none;
            border-radius: 10px;
            padding: 8px 20px;
            color: white;
            font-weight: 600;
            margin-left: 0.5rem;
        }

        .user-info {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border-radius: 25px;
            padding: 8px 20px;
            font-weight: 600;
            text-decoration: none;
        }

        .stats-section {
            padding: 4rem 0;
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        }

        .stat-item {
            text-align: center;
            padding: 2rem;
        }

        .stat-number {
            font-size: 3rem;
            font-weight: 700;
            color: #667eea;
            margin-bottom: 0.5rem;
        }

        .verification-demo {
            background: #f8f9fa;
            border-radius: 20px;
            padding: 3rem;
            margin: 3rem 0;
        }

        .qr-placeholder {
            width: 150px;
            height: 150px;
            background: white;
            border: 3px solid #667eea;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            font-size: 4rem;
            color: #667eea;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-certificate"></i>
                QR Certificate System
            </a>

            <div class="navbar-nav ms-auto d-flex flex-row align-items-center gap-2">
                @if (isSignedIn)
                {
                    <a href="@dashboardUrl" class="btn btn-warning btn-sm">
                        <i class="fas fa-tachometer-alt"></i> Dashboard
                    </a>
                    <a href="/Account/Profile" class="user-info">
                        <i class="fas fa-user"></i> @User.Identity!.Name
                    </a>
                    <partial name="_LogoutButton" model="@("btn btn-outline-danger btn-sm")" />
                }
                else
                {
                    <a href="/Account/Login" class="btn btn-auth">
                        <i class="fas fa-sign-in-alt"></i> Sign In
                    </a>
                    <a href="/Account/Register" class="btn btn-auth">
                        <i class="fas fa-user-plus"></i> Register
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 mx-auto">
                    <h1 class="hero-title">
                        <i class="fas fa-shield-check"></i><br>
                        Digital Certificate Platform
                    </h1>
                    <p class="hero-subtitle">
                        Universities issue tamper-proof certificates, students keep them, anyone verifies them with a QR code.
                    </p>

                    <div class="feature-cards">
                        <div class="row g-4">
                            <div class="col-lg-3 col-md-6">
                                <div class="feature-card">
                                    <div class="feature-icon"><i class="fas fa-qrcode"></i></div>
                                    <h3 class="feature-title">Verify Certificate</h3>
                                    <p class="feature-desc">Scan the QR code or enter the certificate ID</p>
                                    <a href="/verify" class="btn-feature"><i class="fas fa-search"></i> Verify</a>
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6">
                                <div class="feature-card">
                                    <div class="feature-icon"><i class="fas fa-user-graduate"></i></div>
                                    <h3 class="feature-title">Students</h3>
                                    <p class="feature-desc">View your certificates and download them as PDF</p>
                                    @if (User.IsInRole(nameof(UserRole.Student)))
                                    {
                                        <a href="/Student/MyCertificates" class="btn-feature"><i class="fas fa-eye"></i> My Certificates</a>
                                    }
                                    else if (!isSignedIn)
                                    {
                                        <a href="/Account/Register" class="btn-feature"><i class="fas fa-user-plus"></i> Register</a>
                                    }
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6">
                                <div class="feature-card">
                                    <div class="feature-icon"><i class="fas fa-university"></i></div>
                                    <h3 class="feature-title">Universities</h3>
                                    <p class="feature-desc">Issue, edit and revoke signed certificates</p>
                                    @if (User.IsInRole(nameof(UserRole.UniversityAdmin)))
                                    {
                                        <a href="/Admin" class="btn-feature"><i class="fas fa-tachometer-alt"></i> Admin Panel</a>
                                    }
                                    else if (!isSignedIn)
                                    {
                                        <a href="/Account/RegisterUniversity" class="btn-feature"><i class="fas fa-building"></i> Apply</a>
                                    }
                                </div>
                            </div>

                            <div class="col-lg-3 col-md-6">
                                <div class="feature-card">
                                    <div class="feature-icon"><i class="fas fa-user-circle"></i></div>
                                    <h3 class="feature-title">My Profile</h3>
                                    <p class="feature-desc">See your account and university information</p>
                                    @if (isSignedIn)
                                    {
                                        <a href="/Account/Profile" class="btn-feature"><i class="fas fa-user"></i> Profile</a>
                                    }
                                    else
                                    {
                                        <a href="/Account/Login" class="btn-feature"><i class="fas fa-sign-in-alt"></i> Sign In</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <section class="main-content">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-8 mx-auto">
                    <div class="verification-demo text-center">
                        <h3 class="mb-4">
                            <i class="fas fa-bolt text-warning"></i> Quick Verification
                        </h3>

                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <form action="/verify" method="get" class="mb-4">
                                    <div class="input-group">
                                        <input type="text" name="certificateId" class="form-control form-control-lg"
                                               placeholder="Enter Certificate ID" required>
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            <i class="fas fa-search"></i> Verify
                                        </button>
                                    </div>
                                </form>
                            </div>
                            <div class="col-md-6">
                                <div class="qr-placeholder">
                                    <i class="fas fa-qrcode"></i>
                                </div>
                                <small class="text-muted">Scan the QR code on a diploma with your phone camera</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <div class="stat-item">
                        <div class="stat-number">@ViewBag.ActiveCertificates</div>
                        <h5 class="text-muted">Active Certificates</h5>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-item">
                        <div class="stat-number">@ViewBag.Universities</div>
                        <h5 class="text-muted">Universities</h5>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="stat-item">
                        <div class="stat-number">@ViewBag.Verifications</div>
                        <h5 class="text-muted">Verifications</h5>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer class="bg-dark text-white py-4">
        <div class="container">
            <h5>QR Certificate System</h5>
            <p class="mb-0 opacity-75">Secure digital certificate management platform</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
