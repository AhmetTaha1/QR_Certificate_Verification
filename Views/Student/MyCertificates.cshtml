@model List<QRCertificateSystem.Models.Certificate>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Certificates - QR Certificate System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background: #f4f7fb; font-family: 'Inter', sans-serif; }
        .page-header { padding: 2rem 0; }
        .card-shadow { box-shadow: 0 10px 30px rgba(0,0,0,0.08); border: none; }
    </style>
</head>
<body>
    <div class="container">
        <div class="page-header d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1"><i class="fas fa-certificate text-primary"></i> My Certificates</h2>
                <p class="text-muted mb-0">Hello @User.Identity!.Name, you can view your assigned certificates below.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/" class="btn btn-outline-secondary btn-sm"><i class="fas fa-home"></i> Home</a>
                <a href="/Account/Profile" class="btn btn-outline-info btn-sm"><i class="fas fa-user"></i> Profile</a>
                <partial name="_LogoutButton" model="@("btn btn-outline-danger btn-sm")" />
            </div>
        </div>

        <div class="card card-shadow">
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Certificate ID</th>
                                    <th>Program</th>
                                    <th>University</th>
                                    <th>Issue Date</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cert in Model)
                                {
                                    <tr>
                                        <td><code>@cert.CertificateId</code></td>
                                        <td>@cert.Department</td>
                                        <td>@cert.University?.Name</td>
                                        <td>@cert.IssueDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @if (cert.Status == CertificateStatus.Approved)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">@cert.Status</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-success" href="/Student/Diploma/@cert.Id" target="_blank">
                                                <i class="fas fa-eye"></i> View / PDF
                                            </a>
                                            <a class="btn btn-sm btn-outline-primary" href="/verify/@cert.CertificateId" target="_blank">
                                                <i class="fas fa-qrcode"></i> Verify
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-info-circle"></i> No certificates assigned yet. Your university admin links certificates to your student number.
                    </div>
                }
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
