@model VerificationResult
@{
    var c = Model.Certificate;
    var (title, message, icon) = Model.Status switch
    {
        VerificationStatus.Revoked => ("CERTIFICATE REVOKED", "This certificate was issued but has been revoked by the institution.", "fa-ban"),
        VerificationStatus.NotIssued => ("CERTIFICATE NOT ISSUED", "This certificate has not been approved by the institution.", "fa-hourglass-half"),
        VerificationStatus.Tampered => ("INVALID CERTIFICATE", "The stored data does not match its digital signature. Do not trust this certificate.", "fa-triangle-exclamation"),
        _ => ("CERTIFICATE NOT FOUND", "No certificate with this ID is registered in our system.", "fa-circle-question")
    };
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <title>Certificate Verification - QR Certificate System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }

        .verification-container {
            max-width: 900px;
            margin: 0 auto;
        }

        .certificate-card {
            background: white;
            border-radius: 25px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
            overflow: hidden;
            border: 3px solid transparent;
            transition: all 0.3s ease;
        }

        .certificate-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.2);
        }

        .success-header {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
            padding: 3rem 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .success-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            animation: pulse 3s ease-in-out infinite;
        }

        @@keyframes pulse {

            0%,
            100% {
                transform: scale(1);
                opacity: 0.5;
            }

            50% {
                transform: scale(1.1);
                opacity: 0.8;
            }
        }

        .success-icon {
            font-size: 5rem;
            margin-bottom: 1rem;
            position: relative;
            z-index: 1;
            animation: bounce 1s ease-in-out;
        }

        @@keyframes bounce {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-20px);
            }
        }

        .success-header h2 {
            font-weight: 700;
            font-size: 2rem;
            margin-bottom: 0.5rem;
            position: relative;
            z-index: 1;
        }

        .error-header {
            background: linear-gradient(135deg, #dc3545, #c82333);
            color: white;
            padding: 3rem 2rem;
            text-align: center;
        }

        .error-icon {
            font-size: 5rem;
            margin-bottom: 1rem;
        }

        .certificate-info {
            padding: 3rem;
        }

        .security-badges {
            display: flex;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 2rem;
        }

        .security-badge {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
            transition: all 0.3s ease;
        }

        .security-badge:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
        }

        .info-section {
            background: #f8f9fa;
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 0;
            border-bottom: 1px solid #e9ecef;
            transition: all 0.3s ease;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-row:hover {
            background: rgba(102, 126, 234, 0.05);
            padding-left: 1rem;
            border-radius: 10px;
        }

        .info-row strong {
            color: #2d3748;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .info-row span {
            color: #4a5568;
            font-size: 1rem;
            font-weight: 500;
        }

        .info-row code {
            background: #667eea;
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .error-info {
            padding: 3rem;
        }

        .error-badge {
            background: #dc3545;
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 25px;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-block;
            margin: 0.5rem;
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-top: 2rem;
            flex-wrap: wrap;
        }

        .btn-action {
            padding: 1rem 2rem;
            border-radius: 15px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-primary-action {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.3);
        }

        .btn-primary-action:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(102, 126, 234, 0.4);
            color: white;
        }

        .btn-secondary-action {
            background: white;
            color: #667eea;
            border: 2px solid #667eea;
        }

        .btn-secondary-action:hover {
            background: #667eea;
            color: white;
        }

        .gpa-display {
            background: linear-gradient(135deg, #ffd700, #ffed4e);
            color: #2d3748;
            padding: 0.75rem 1.5rem;
            border-radius: 15px;
            font-weight: 700;
            font-size: 1.2rem;
            display: inline-block;
        }

        .degree-badge {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 10px;
            font-weight: 600;
            display: inline-block;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="verification-container">
            @if (Model.IsValid && c != null)
            {
                <div class="certificate-card">
                    <div class="success-header">
                        <i class="fas fa-check-circle success-icon"></i>
                        <h2 class="mt-3">CERTIFICATE VERIFIED</h2>
                        <p class="mb-0">This certificate is authentic and currently valid</p>
                    </div>
                    <div class="certificate-info">
                        <div class="security-badges">
                            <span class="security-badge">
                                <i class="fas fa-signature"></i> HMAC-SHA256 Signature OK
                            </span>
                            <span class="security-badge">
                                <i class="fas fa-database"></i> Registered by Institution
                            </span>
                        </div>

                        <div class="info-section">
                            <div class="info-row">
                                <strong><i class="fas fa-user text-primary"></i> Full Name:</strong>
                                <span>@c.Name</span>
                            </div>
                            <div class="info-row">
                                <strong><i class="fas fa-university text-info"></i> Institution:</strong>
                                <span>@c.Institution</span>
                            </div>
                            <div class="info-row">
                                <strong><i class="fas fa-graduation-cap text-success"></i> Department:</strong>
                                <span>@c.Department</span>
                            </div>
                            @if (!string.IsNullOrEmpty(c.Degree))
                            {
                                <div class="info-row">
                                    <strong><i class="fas fa-graduation-cap text-primary"></i> Degree:</strong>
                                    <span><span class="degree-badge">@c.Degree</span></span>
                                </div>
                            }
                            @if (c.GPA.HasValue)
                            {
                                <div class="info-row">
                                    <strong><i class="fas fa-star text-warning"></i> GPA:</strong>
                                    <span><span class="gpa-display">@c.GPA.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span></span>
                                </div>
                            }
                            <div class="info-row">
                                <strong><i class="fas fa-calendar text-warning"></i> Issue Date:</strong>
                                <span>@c.IssueDate.ToString("MMMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                            </div>
                            <div class="info-row">
                                <strong><i class="fas fa-fingerprint text-danger"></i> Certificate ID:</strong>
                                <span><code>@c.CertificateId</code></span>
                            </div>
                        </div>

                        <div class="action-buttons">
                            <a href="/" class="btn-action btn-primary-action">
                                <i class="fas fa-home"></i> Back to Home
                            </a>
                            <a href="/verify" class="btn-action btn-secondary-action">
                                <i class="fas fa-search"></i> Verify Another
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="certificate-card">
                    <div class="error-header">
                        <i class="fas @icon error-icon"></i>
                        <h2 class="mt-3">@title</h2>
                    </div>
                    <div class="error-info">
                        <div class="alert alert-warning">
                            <i class="fas fa-info-circle"></i>
                            @message
                        </div>

                        <div class="info-section">
                            <div class="info-row">
                                <strong><i class="fas fa-fingerprint text-danger"></i> Certificate ID:</strong>
                                <span><code>@Model.CertificateId</code></span>
                            </div>
                            @* Only show identifying data when the signature is intact. *@
                            @if (c != null && Model.Status != VerificationStatus.Tampered)
                            {
                                <div class="info-row">
                                    <strong><i class="fas fa-user text-primary"></i> Name:</strong>
                                    <span>@c.Name</span>
                                </div>
                                <div class="info-row">
                                    <strong><i class="fas fa-university text-info"></i> Institution:</strong>
                                    <span>@c.Institution</span>
                                </div>
                            }
                        </div>

                        <div class="action-buttons">
                            <a href="/" class="btn-action btn-primary-action">
                                <i class="fas fa-home"></i> Back to Home
                            </a>
                            <a href="/verify" class="btn-action btn-secondary-action">
                                <i class="fas fa-search"></i> Try Again
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</body>

</html>
