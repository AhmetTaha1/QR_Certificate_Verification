@model QRCertificateSystem.Models.User
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - QR Certificate System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 2rem 0;
        }

        .profile-container {
            max-width: 900px;
            margin: 0 auto;
        }

        .profile-card {
            background: white;
            border-radius: 25px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
            overflow: hidden;
        }

        .profile-header {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 3rem 2rem;
            text-align: center;
        }

        .profile-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            font-size: 3rem;
            border: 4px solid white;
        }

        .profile-body {
            padding: 3rem;
        }

        .info-section {
            background: #f8f9fa;
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 0;
            border-bottom: 1px solid #e9ecef;
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            font-weight: 600;
            color: #2d3748;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .info-value {
            color: #4a5568;
            font-weight: 500;
        }

        .badge-role {
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .badge-admin {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
        }

        .badge-student {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: white;
        }

        .btn-back {
            background: linear-gradient(135deg, #6c757d, #5a6268);
            border: none;
            border-radius: 15px;
            padding: 10px 30px;
            color: white;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 210px;
            white-space: nowrap;
        }

        .btn-back:hover {
            transform: translateY(-2px);
            color: white;
            box-shadow: 0 8px 20px rgba(108, 117, 125, 0.3);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="profile-container">
            <div class="profile-card">
                <div class="profile-header">
                    <div class="profile-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <h2 class="mb-2">@Model.FullName</h2>
                    <p class="mb-0 opacity-75">@Model.Email</p>
                </div>

                <div class="profile-body">
                    <div class="info-section">
                        <h4 class="mb-4">
                            <i class="fas fa-info-circle text-primary me-2"></i>
                            Personal Information
                        </h4>
                        
                        <div class="info-row">
                            <span class="info-label">
                                <i class="fas fa-user text-primary"></i>
                                Full Name
                            </span>
                            <span class="info-value">@Model.FullName</span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">
                                <i class="fas fa-envelope text-info"></i>
                                Email
                            </span>
                            <span class="info-value">@Model.Email</span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <div class="info-row">
                                <span class="info-label">
                                    <i class="fas fa-phone text-success"></i>
                                    Phone Number
                                </span>
                                <span class="info-value">@Model.PhoneNumber</span>
                            </div>
                        }

                        <div class="info-row">
                            <span class="info-label">
                                <i class="fas fa-shield-alt text-warning"></i>
                                Role
                            </span>
                            <span class="info-value">
                                @if (Model.Role == UserRole.UniversityAdmin)
                                {
                                    <span class="badge-role badge-admin">
                                        <i class="fas fa-user-shield me-1"></i>
                                        Admin
                                    </span>
                                }
                                else if (Model.Role == UserRole.Student)
                                {
                                    <span class="badge-role badge-student">
                                        <i class="fas fa-user-graduate me-1"></i>
                                        Student
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-role badge-admin">
                                        <i class="fas fa-crown me-1"></i>
                                        Super Admin
                                    </span>
                                }
                            </span>
                        </div>
                    </div>

                    @if (Model.University != null)
                    {
                        <div class="info-section">
                            <h4 class="mb-4">
                                <i class="fas fa-university text-primary me-2"></i>
                                University Information
                            </h4>
                            
                            <div class="info-row">
                                <span class="info-label">
                                    <i class="fas fa-building text-primary"></i>
                                    University
                                </span>
                                <span class="info-value">@Model.University.Name</span>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.University.ShortName))
                            {
                                <div class="info-row">
                                    <span class="info-label">
                                        <i class="fas fa-tag text-info"></i>
                                        Short Name
                                    </span>
                                    <span class="info-value">@Model.University.ShortName</span>
                                </div>
                            }
                        </div>
                    }

                    @if (Model.Student != null)
                    {
                        <div class="info-section">
                            <h4 class="mb-4">
                                <i class="fas fa-graduation-cap text-success me-2"></i>
                                Student Information
                            </h4>
                            
                            <div class="info-row">
                                <span class="info-label">
                                    <i class="fas fa-id-card text-primary"></i>
                                    Student Number
                                </span>
                                <span class="info-value">@Model.Student.StudentNumber</span>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Student.Department))
                            {
                                <div class="info-row">
                                    <span class="info-label">
                                        <i class="fas fa-tag text-info"></i>
                                        Department
                                    </span>
                                    <span class="info-value">@Model.Student.Department</span>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.Student.Faculty))
                            {
                                <div class="info-row">
                                    <span class="info-label">
                                        <i class="fas fa-school text-success"></i>
                                        Faculty
                                    </span>
                                    <span class="info-value">@Model.Student.Faculty</span>
                                </div>
                            }

                            @if (Model.Student.EnrollmentYear.HasValue)
                            {
                                <div class="info-row">
                                    <span class="info-label">
                                        <i class="fas fa-calendar text-warning"></i>
                                        Enrollment Year
                                    </span>
                                    <span class="info-value">@Model.Student.EnrollmentYear</span>
                                </div>
                            }

                            @if (Model.Student.GPA.HasValue)
                            {
                                <div class="info-row">
                                    <span class="info-label">
                                        <i class="fas fa-star text-warning"></i>
                                        GPA
                                    </span>
                                    <span class="info-value">@Model.Student.GPA.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                                </div>
                            }
                        </div>
                    }

                    <div class="info-section">
                        <h4 class="mb-4">
                            <i class="fas fa-clock text-secondary me-2"></i>
                            Account Information
                        </h4>
                        
                        <div class="info-row">
                            <span class="info-label">
                                <i class="fas fa-calendar-plus text-success"></i>
                                Account Created
                            </span>
                            <span class="info-value">@Model.CreatedAt.ToString("MMMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                        </div>

                        @if (Model.LastLoginAt.HasValue)
                        {
                            <div class="info-row">
                                <span class="info-label">
                                    <i class="fas fa-sign-in-alt text-info"></i>
                                    Last Login
                                </span>
                                <span class="info-value">@Model.LastLoginAt.Value.ToString("MMMM dd, yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) UTC</span>
                            </div>
                        }

                        <div class="info-row">
                            <span class="info-label">
                                <i class="fas fa-check-circle text-success"></i>
                                Status
                            </span>
                            <span class="info-value">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </span>
                        </div>

                        <div class="info-row">
                            <span class="info-label">
                                <i class="fas fa-envelope-circle-check text-info"></i>
                                Email Verified
                            </span>
                            <span class="info-value">
                                @if (Model.EmailConfirmed)
                                {
                                    <span class="badge bg-success">Verified</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Not Verified</span>
                                }
                            </span>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        @{
                            var backUrl = Model.Role switch
                            {
                                UserRole.SuperAdmin => "/SuperAdmin",
                                UserRole.UniversityAdmin => "/Admin",
                                _ => "/Student/MyCertificates"
                            };
                        }
                        <a href="@backUrl" class="btn-back me-2">
                            <i class="fas fa-arrow-left me-2"></i>
                            Back to Dashboard
                        </a>
                        <a href="/" class="btn-back">
                            <i class="fas fa-home me-2"></i>
                            Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
