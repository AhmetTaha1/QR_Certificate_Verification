@model QRCertificateSystem.Models.Certificate
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diploma Preview</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background: #f2f5f9;
            padding: 2rem;
            font-family: 'Inter', sans-serif;
        }
        .diploma-wrapper {
            max-width: 1100px;
            margin: 0 auto;
        }
        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }
        .diploma-card {
            position: relative;
            background: linear-gradient(135deg, #fdfcfb 0%, #e2d1c3 100%);
            border: 6px solid #1e3a8a;
            border-radius: 16px;
            padding: 40px 50px;
            min-height: 700px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
        }
        .diploma-inner {
            border: 2px dashed #1e3a8a;
            border-radius: 12px;
            padding: 30px;
            min-height: 620px;
            position: relative;
        }
        .diploma-header {
            text-align: center;
            margin-bottom: 30px;
        }
        .university-name {
            font-size: 32px;
            font-weight: 800;
            color: #1e3a8a;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .diploma-title {
            font-size: 26px;
            font-weight: 700;
            margin-top: 10px;
            color: #2d3748;
        }
        .divider {
            height: 4px;
            width: 140px;
            background: #1e3a8a;
            margin: 18px auto;
        }
        .recipient {
            text-align: center;
            margin: 30px 0;
        }
        .recipient .label {
            font-size: 16px;
            color: #4a5568;
        }
        .recipient .name {
            font-size: 34px;
            font-weight: 800;
            color: #1a202c;
            margin-top: 8px;
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
            margin-top: 20px;
        }
        .info-box {
            background: rgba(255,255,255,0.75);
            border: 1px solid #cbd5e0;
            border-radius: 12px;
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 600;
            color: #2d3748;
        }
        .qr-box {
            position: absolute;
            bottom: 24px;
            right: 24px;
            text-align: center;
        }
        .qr-box img {
            width: 140px;
            height: 140px;
            border: 4px solid #1e3a8a;
            border-radius: 12px;
            background: white;
        }
        .signatures {
            display: flex;
            justify-content: space-between;
            margin-top: 50px;
        }
        .sig {
            text-align: center;
            width: 45%;
        }
        .sig .line {
            margin-top: 50px;
            border-top: 2px solid #1e3a8a;
        }
        .badge-status {
            position: absolute;
            top: -20px;
            right: 20px;
            background: #16a34a;
            color: white;
            padding: 10px 16px;
            border-radius: 999px;
            box-shadow: 0 8px 20px rgba(22, 163, 74, 0.3);
            font-weight: 700;
        }
    </style>
</head>
<body>
    <div class="diploma-wrapper">
        <div class="toolbar">
            <div>
                @{
                    var backUrl = User.IsInRole(nameof(UserRole.UniversityAdmin)) ? "/Admin" : "/Student/MyCertificates";
                }
                <a href="@backUrl" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left"></i> Back
                </a>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-primary btn-sm" href="/verify/@Model.CertificateId" target="_blank">
                    <i class="fas fa-qrcode"></i> Verify Page
                </a>
                <button class="btn btn-success btn-sm" id="btnDownloadPdf">
                    <i class="fas fa-file-pdf"></i> Download PDF
                </button>
            </div>
        </div>

        <div id="diplomaArea" class="diploma-card">
            <div class="diploma-inner">
                @if (Model.Status == CertificateStatus.Approved)
                {
                    <span class="badge-status">Verified QR</span>
                }
                else
                {
                    <span class="badge-status" style="background:#dc2626">@Model.Status.ToString().ToUpperInvariant()</span>
                }

                <div class="diploma-header">
                    <div class="university-name">@Model.University?.Name</div>
                    <div class="divider"></div>
                    <div class="diploma-title">OFFICIAL DIPLOMA / CERTIFICATE</div>
                    <div class="text-muted">Certificate ID: @Model.CertificateId</div>
                </div>

                <div class="recipient">
                    <div class="label">Awarded to</div>
                    <div class="name">@Model.Name</div>
                </div>

                <div class="info-grid">
                    <div class="info-box">
                        <span>Department</span>
                        <span>@Model.Department</span>
                    </div>
                    <div class="info-box">
                        <span>Institution</span>
                        <span>@Model.Institution</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Degree))
                    {
                        <div class="info-box">
                            <span>Degree</span>
                            <span>@Model.Degree</span>
                        </div>
                    }
                    @if (Model.GPA.HasValue)
                    {
                        <div class="info-box">
                            <span>GPA</span>
                            <span>@Model.GPA.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</span>
                        </div>
                    }
                    <div class="info-box">
                        <span>Issue Date</span>
                        <span>@Model.IssueDate.ToString("MMMM dd, yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                    </div>
                    <div class="info-box">
                        <span>Status</span>
                        <span>@Model.Status</span>
                    </div>
                </div>

                <div class="signatures">
                    <div class="sig">
                        <div>__________________________</div>
                        <div class="mt-2">Dean / Registrar</div>
                    </div>
                    <div class="sig">
                        <div>__________________________</div>
                        <div class="mt-2">Faculty Advisor</div>
                    </div>
                </div>

                <div class="qr-box">
                    <img src="/api/certificate/qrcode/@Model.CertificateId" alt="QR Code" />
                    <div class="mt-2 small text-muted">Scan to verify</div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        document.getElementById('btnDownloadPdf').addEventListener('click', async () => {
            const { jsPDF } = window.jspdf;
            const diploma = document.getElementById('diplomaArea');
            const canvas = await html2canvas(diploma, { scale: 2, useCORS: true });
            const imgData = canvas.toDataURL('image/png');
            const pdf = new jsPDF('l', 'pt', [canvas.width, canvas.height]);
            pdf.addImage(imgData, 'PNG', 0, 0, canvas.width, canvas.height);
            const fileName = "Diploma-@(Model.CertificateId).pdf";
            pdf.save(fileName);
        });
    </script>
</body>
</html>
