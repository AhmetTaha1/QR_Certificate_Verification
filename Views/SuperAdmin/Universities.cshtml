@model List<University>
@{
    var certificateCounts = ViewBag.CertificateCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Universities - QR Certificate System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/SuperAdmin"><i class="fas fa-shield-alt"></i> SuperAdmin Panel</a>
            <div class="navbar-nav ms-auto d-flex flex-row align-items-center">
                <partial name="_LogoutButton" model="@("btn btn-outline-light btn-sm")" />
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0"><i class="fas fa-university text-primary"></i> Universities</h3>
            <a href="/SuperAdmin" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left"></i> Dashboard</a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>University</th>
                                <th>City</th>
                                <th>Admin</th>
                                <th>Certificates</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var uni in Model)
                            {
                                var admin = uni.Users.FirstOrDefault();
                                <tr>
                                    <td>
                                        <strong>@uni.Name</strong> <span class="text-muted">(@uni.ShortName)</span>
                                        @if (!string.IsNullOrEmpty(uni.Website))
                                        {
                                            <br /><a href="@uni.Website" target="_blank" rel="noopener noreferrer" class="small">@uni.Website</a>
                                        }
                                    </td>
                                    <td>@uni.City</td>
                                    <td>
                                        @if (admin != null)
                                        {
                                            @admin.FullName<br /><span class="small text-muted">@admin.Email</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">&ndash;</span>
                                        }
                                    </td>
                                    <td>@(certificateCounts.TryGetValue(uni.Id, out var count) ? count : 0)</td>
                                    <td>
                                        @if (uni.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (!uni.IsActive)
                                        {
                                            <form method="post" action="/SuperAdmin/ApproveUniversity/@uni.Id" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-check"></i> Approve</button>
                                            </form>
                                            <form method="post" action="/SuperAdmin/RejectUniversity/@uni.Id" class="d-inline"
                                                  onsubmit="return confirm('Reject and delete this registration?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fas fa-times"></i> Reject</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
