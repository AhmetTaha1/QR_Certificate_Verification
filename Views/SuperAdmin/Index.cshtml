<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SuperAdmin Dashboard - QR Certificate System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 15px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .stat-number {
            font-size: 2rem;
            font-weight: bold;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/SuperAdmin"><i class="fas fa-shield-alt"></i> SuperAdmin Panel</a>
            <div class="navbar-nav ms-auto d-flex flex-row align-items-center">
                <a class="nav-link me-2" href="/Account/Profile"><i class="fas fa-user-circle"></i> @User.Identity!.Name</a>
                <partial name="_LogoutButton" model="@("btn btn-outline-light btn-sm")" />
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        <div class="row">
            <div class="col-md-3">
                <div class="stat-card text-center">
                    <i class="fas fa-university fa-2x mb-2"></i>
                    <div class="stat-number">@ViewBag.TotalUniversities</div>
                    <div>Total Universities</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card text-center">
                    <i class="fas fa-clock fa-2x mb-2"></i>
                    <div class="stat-number">@ViewBag.PendingUniversities</div>
                    <div>Pending Approval</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card text-center">
                    <i class="fas fa-users fa-2x mb-2"></i>
                    <div class="stat-number">@ViewBag.TotalUsers</div>
                    <div>Total Users</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card text-center">
                    <i class="fas fa-certificate fa-2x mb-2"></i>
                    <div class="stat-number">@ViewBag.TotalCertificates</div>
                    <div>Certificates</div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5><i class="fas fa-tasks"></i> Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <a href="/SuperAdmin/Universities" class="btn btn-outline-primary w-100 mb-2">
                                    <i class="fas fa-university"></i> Manage Universities
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="/verify" class="btn btn-outline-success w-100 mb-2">
                                    <i class="fas fa-qrcode"></i> Verify a Certificate
                                </a>
                            </div>
                            <div class="col-md-4">
                                <a href="/Account/Profile" class="btn btn-outline-secondary w-100 mb-2">
                                    <i class="fas fa-user-circle"></i> My Profile
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (ViewBag.PendingUniversities > 0)
        {
            <div class="row mt-4">
                <div class="col-md-12">
                    <div class="alert alert-warning">
                        <h5><i class="fas fa-exclamation-triangle"></i> Attention Required</h5>
                        <p>You have <strong>@ViewBag.PendingUniversities</strong> university registrations waiting for
                            approval.</p>
                        <a href="/SuperAdmin/Universities" class="btn btn-warning">Review Now</a>
                    </div>
                </div>
            </div>
        }
    </div>
</body>

</html>